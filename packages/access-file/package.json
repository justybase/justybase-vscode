{
  "name": "@justybase/access-file",
  "version": "3.16.28",
  "description": "Pure Node.js/TypeScript Access file session and format boundary for MDB/ACCDB.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./complexValues": {
      "types": "./dist/complexValues.d.ts",
      "require": "./dist/complexValues.js",
      "default": "./dist/complexValues.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "require": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./jet/JetLayout": {
      "types": "./dist/jet/JetLayout.d.ts",
      "require": "./dist/jet/JetLayout.js",
      "default": "./dist/jet/JetLayout.js"
    },
    "./jet/JetPageChannel": {
      "types": "./dist/jet/JetPageChannel.d.ts",
      "require": "./dist/jet/JetPageChannel.js",
      "default": "./dist/jet/JetPageChannel.js"
    }
  },
  "license": "Apache-2.0",
  "homepage": "https://justybase.github.io/vscode/",
  "repository": {
    "type": "git",
    "url": "https://github.com/justybase/justybase-vscode"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "mdb-reader": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  }
}
