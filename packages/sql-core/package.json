{
  "name": "@justybase/sql-core",
  "private": true,
  "version": "3.16.8",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "require": "./dist/validation.js",
      "default": "./dist/validation.js"
    },
    "./quality": {
      "types": "./dist/quality/index.d.ts",
      "require": "./dist/quality/index.js",
      "default": "./dist/quality/index.js"
    },
    "./authoring": {
      "types": "./dist/authoring/index.d.ts",
      "require": "./dist/authoring/index.js",
      "default": "./dist/authoring/index.js"
    },
    "./authoring/*": {
      "types": "./dist/authoring/*.d.ts",
      "require": "./dist/authoring/*.js",
      "default": "./dist/authoring/*.js"
    },
    "./parser/BaseSqlParser": {
      "types": "./dist/parser/BaseSqlParser.d.ts",
      "require": "./dist/parser/BaseSqlParser.js",
      "default": "./dist/parser/BaseSqlParser.js"
    },
    "./parser/queryClauseComparisonRules": {
      "types": "./dist/parser/queryClauseComparisonRules.d.ts",
      "require": "./dist/parser/queryClauseComparisonRules.js",
      "default": "./dist/parser/queryClauseComparisonRules.js"
    },
    "./netezza/parser": {
      "types": "./dist/netezza/parser.d.ts",
      "require": "./dist/netezza/parser.js",
      "default": "./dist/netezza/parser.js"
    },
    "./netezza/lexer": {
      "types": "./dist/netezza/lexer.d.ts",
      "require": "./dist/netezza/lexer.js",
      "default": "./dist/netezza/lexer.js"
    },
    "./netezza/identifierPattern": {
      "types": "./dist/netezza/identifierPattern.d.ts",
      "require": "./dist/netezza/identifierPattern.js",
      "default": "./dist/netezza/identifierPattern.js"
    },
    "./sourceScan": {
      "types": "./dist/sourceScan.d.ts",
      "require": "./dist/sourceScan.js",
      "default": "./dist/sourceScan.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-sql-core.js",
    "check-types": "tsc -p tsconfig.build.json --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@justybase/contracts": "*",
    "chevrotain": "^12.0.0"
  }
}
