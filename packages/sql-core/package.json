{
  "name": "@justybase/sql-core",
  "private": true,
  "version": "3.16.8",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "require": "./dist/validation.js",
      "default": "./dist/validation.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-sql-core.js",
    "check-types": "tsc --ignoreConfig --noEmit --module commonjs --moduleResolution bundler --target es2022 --lib es2022 --types node --strict --esModuleInterop --skipLibCheck src/runtime.ts src/validation.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@justybase/contracts": "*",
    "chevrotain": "^12.0.0",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.13"
  }
}
