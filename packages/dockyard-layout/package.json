{
  "name": "@justybase/dockyard-layout",
  "private": true,
  "version": "3.17.14",
  "description": "Platform-neutral Dockyard layout model, persistence and DOM adapter for JustyBase shells.",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
