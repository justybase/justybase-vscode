      "default": "./dist/index.js"
    }
  },
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@justybase/contracts": "*",
    "@justybase/ui-core": "*"
  },
  "devDependencies": {
    "typescript": "^6.0.0"
  }
