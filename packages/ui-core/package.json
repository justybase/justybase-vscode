{
  "name": "@justybase/ui-core",
  "private": true,
  "version": "3.17.14",
  "description": "Platform-neutral state, ports, capabilities, persistence and lifecycle for JustyBase UI surfaces.",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./menuIcons": {
      "types": "./dist/menuIcons.d.ts",
      "require": "./dist/menuIcons.js",
      "default": "./dist/menuIcons.js"
    }
  },
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.build.json",
    "check-types": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@justybase/contracts": "*"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "typescript": "^6.0.0"
  }
}
