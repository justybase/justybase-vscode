{
  "version": 1,
  "packageDependencies": {
    "packages/contracts": [],
    "packages/sql-core": [
      "packages/contracts"
    ],
    "packages/designer-core": [
      "packages/contracts",
      "packages/dialect-utils"
    ],
    "packages/metadata-core": [],
    "packages/database-runtime": [
      "packages/contracts",
      "packages/designer-core",
      "packages/netezza-runtime"
    ],
    "packages/sqlite-runtime": [
      "packages/contracts"
    ],
    "packages/duckdb-runtime": [
      "packages/contracts"
    ],
    "packages/netezza-runtime": [
      "packages/contracts"
    ],
    "packages/access-file": [],
    "packages/result-core": [],
    "packages/database-utils": [
      "packages/contracts"
    ],
    "packages/tabular-import-runtime": [
      "packages/contracts",
      "packages/database-utils",
      "packages/dialect-utils"
    ],
    "packages/file-runtime": [
      "packages/contracts"
    ],
    "packages/dialect-utils": [
      "packages/contracts",
      "packages/sql-core"
    ],
    "packages/vscode-companion-adapter": [
      "packages/contracts"
    ]
  },
  "browserSources": [
    "media/**",
    "apps/web/src/**"
  ],
  "browserExternalImports": [
    "react",
    "react/jsx-runtime",
    "react-dom/client",
    "@monaco-editor/react",
    "monaco-editor",
    "@msgpack/msgpack",
    "@tanstack/react-query",
    "@tanstack/react-table",
    "@tanstack/react-virtual",
    "@tanstack/table-core",
    "@tanstack/virtual-core",
    "@xyflow/react",
    "@xyflow/react/dist/style.css",
    "echarts/charts",
    "echarts/components",
    "echarts/core",
    "echarts/renderers",
    "elkjs/lib/elk.bundled.js"
  ],
  "pureSources": [
    "packages/contracts/src/**",
    "packages/database-utils/src/**",
    "packages/dialect-utils/src/**",
    "packages/*-core/src/**"
  ],
  "pureExternalImports": [
    "chevrotain"
  ],
  "pureExternalExceptions": [],
  "layers": {
    "contracts": {
      "sources": [
        "packages/contracts/src"
      ]
    },
    "shared": {
      "sources": [
        "packages/*/src"
      ]
    },
    "desktop": {
      "sources": [
        "src"
      ]
    },
    "media": {
      "sources": [
        "media"
      ]
    },
    "api": {
      "sources": [
        "apps/api/src"
      ]
    },
    "web": {
      "sources": [
        "apps/web/src"
      ]
    },
    "companions": {
      "sources": [
        "extensions/*/src"
      ]
    }
  },
  "allowedDependencies": {
    "contracts": [
      "contracts"
    ],
    "shared": [
      "contracts",
      "shared"
    ],
    "desktop": [
      "contracts",
      "shared",
      "desktop"
    ],
    "media": [
      "contracts",
      "shared",
      "desktop",
      "media"
    ],
    "api": [
      "contracts",
      "shared",
      "api"
    ],
    "web": [
      "contracts",
      "shared",
      "web"
    ],
    "companions": [
      "contracts",
      "shared",
      "companions"
    ]
  },
  "workspaceEntryPoints": {
    "@justybase/metadata-core": "packages/metadata-core/src/index.ts",
    "@justybase/result-core": "packages/result-core/src/index.ts",
    "@justybase/sql-core": "packages/sql-core/src/index.ts"
  },
  "forbiddenImports": [
    {
      "layer": "desktop",
      "specifier": "^@justybase/netezza-driver(?:/|$)"
    },
    {
      "layer": "api",
      "specifier": "^@justybase/netezza-driver(?:/|$)"
    },
    {
      "layer": "companions",
      "specifier": "^@justybase/netezza-driver(?:/|$)"
    },
    {
      "source": "packages/database-runtime/src/**",
      "specifier": "^@justybase/netezza-driver(?:/|$)"
    },
    {
      "layer": "shared",
      "excludeSource": "packages/vscode-companion-adapter/src/**",
      "specifier": "^(?:vscode|electron)(?:/|$)"
    },
    {
      "source": "packages/designer-core/src/**",
      "specifier": "^(?:react|react-dom|node:|@justybase/(?:netezza-driver|spreadsheet-tasks)(?:/|$))"
    }
  ],
  "exceptions": [],
  "cycleExceptions": []
}
