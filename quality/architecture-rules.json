{
  "version": 1,
  "packageDependencies": {
    "packages/contracts": [],
    "packages/api-client": [
      "packages/contracts"
    ],
    "packages/sql-core": [
      "packages/contracts"
    ],
    "packages/designer-core": [
      "packages/contracts",
      "packages/dialect-utils"
    ],
    "packages/metadata-core": [],
    "packages/database-runtime": [
      "packages/contracts",
      "packages/designer-core",
      "packages/netezza-runtime"
    ],
    "packages/sqlite-runtime": [
      "packages/contracts"
    ],
    "packages/duckdb-runtime": [
      "packages/contracts"
    ],
    "packages/netezza-runtime": [
      "packages/contracts"
    ],
    "packages/access-file": [],
    "packages/result-core": [],
    "packages/database-utils": [
      "packages/contracts"
    ],
    "packages/tabular-import-runtime": [
      "packages/contracts",
      "packages/database-utils",
      "packages/dialect-utils"
    ],
    "packages/file-runtime": [
      "packages/contracts"
    ],
    "packages/dialect-utils": [
      "packages/contracts",
      "packages/sql-core"
    ],
    "packages/vscode-companion-adapter": [
      "packages/contracts"
    ],
    "packages/ui-core": [
      "packages/contracts"
    ],
    "packages/ui-react": [
      "packages/contracts",
      "packages/dialect-utils",
      "packages/designer-core",
      "packages/ui-core"
    ]
  },
  "browserSources": [
    "media/**",
    "apps/web/src/**",
    "apps/electron/src/renderer/**"
  ],
  "browserExternalImports": [
    "react",
    "react/jsx-runtime",
    "react-dom",
    "react-dom/client",
    "@monaco-editor/react",
    "monaco-editor",
    "@msgpack/msgpack",
    "@tanstack/react-query",
    "@tanstack/react-table",
    "@tanstack/react-virtual",
    "@tanstack/table-core",
    "@tanstack/virtual-core",
    "@xyflow/react",
    "@xyflow/react/dist/style.css",
    "echarts/charts",
    "echarts/components",
    "echarts/core",
    "echarts/renderers",
    "elkjs/lib/elk.bundled.js"
  ],
  "pureSources": [
    "packages/contracts/src/**",
    "packages/api-client/src/**",
    "packages/database-utils/src/**",
    "packages/dialect-utils/src/**",
    "packages/*-core/src/**",
    "packages/ui-react/src/**"
  ],
  "pureExternalImports": [
    "chevrotain"
  ],
  "pureExternalExceptions": [
    {
      "source": "packages/ui-react/src/components.tsx",
      "target": "react",
      "reason": "The shared React presentation package necessarily depends on React.",
      "owner": "UI platform maintainers",
      "removeWhen": "Replace the React presentation implementation with a dependency-free renderer."
    },
    {
      "source": "packages/ui-react/src/dataGrid.tsx",
      "target": "react",
      "reason": "The shared result grid is a React presentation component consumed by web, Electron and VS Code adapters.",
      "owner": "UI platform maintainers",
      "removeWhen": "Replace the React presentation implementation with a dependency-free renderer."
    },
    {
      "source": "packages/ui-react/src/resultAnalysis.tsx",
      "target": "react",
      "reason": "Shared result analysis is a React presentation component consumed by product adapters.",
      "owner": "UI platform maintainers",
      "removeWhen": "Replace the React presentation implementation with a dependency-free renderer."
    },
    {
      "source": "packages/ui-react/src/sqlLanguage.ts",
      "target": "monaco-editor",
      "reason": "Shared SQL authoring integration is intentionally implemented against the Monaco editor API.",
      "owner": "SQL authoring maintainers",
      "removeWhen": "Move Monaco integration into a product adapter while retaining the shared authoring contract."
    },
    {
      "source": "packages/ui-react/src/sqlProblems.tsx",
      "target": "monaco-editor",
      "reason": "The shared Problems adapter translates Monaco markers into the portable presentation model.",
      "owner": "SQL authoring maintainers",
      "removeWhen": "Move Monaco marker translation into a product adapter."
    },
    {
      "source": "packages/ui-react/src/sqlProblems.tsx",
      "target": "react",
      "reason": "The shared Problems view is a React presentation component consumed by product adapters.",
      "owner": "UI platform maintainers",
      "removeWhen": "Replace the React presentation implementation with a dependency-free renderer."
    },
    {
      "source": "packages/ui-react/src/sqlShortcuts.ts",
      "target": "monaco-editor",
      "reason": "Shared SQL shortcut registration is intentionally implemented against the Monaco editor API.",
      "owner": "SQL authoring maintainers",
      "removeWhen": "Move Monaco shortcut registration into a product adapter while retaining the shared shortcut semantics."
    },
    {
      "source": "packages/ui-react/src/objectDesigner/ObjectDesigner.tsx",
      "target": "react",
      "reason": "The shared object designer is a React presentation component consumed by product adapters.",
      "owner": "Designer maintainers",
      "removeWhen": "Replace the React designer presentation implementation with a dependency-free renderer."
    },
    {
      "source": "packages/ui-react/src/objectDesigner/useObjectDesignerController.ts",
      "target": "react",
      "reason": "The shared object designer controller uses React state and effects for adapter-owned workflows.",
      "owner": "Designer maintainers",
      "removeWhen": "Move the controller lifecycle into a platform-neutral state machine."
    }
  ],
  "layers": {
    "contracts": {
      "sources": [
        "packages/contracts/src"
      ]
    },
    "shared": {
      "sources": [
        "packages/*/src"
      ]
    },
    "desktop": {
      "sources": [
        "src"
      ]
    },
    "media": {
      "sources": [
        "media"
      ]
    },
    "api": {
      "sources": [
        "apps/api/src"
      ]
    },
    "web": {
      "sources": [
        "apps/web/src"
      ]
    },
    "electron-main": {
      "sources": [
        "apps/electron/src/main"
      ]
    },
    "electron-preload": {
      "sources": [
        "apps/electron/src/preload"
      ]
    },
    "electron-renderer": {
      "sources": [
        "apps/electron/src/renderer"
      ]
    },
    "companions": {
      "sources": [
        "extensions/*/src"
      ]
    }
  },
  "allowedDependencies": {
    "contracts": [
      "contracts"
    ],
    "shared": [
      "contracts",
      "shared"
    ],
    "desktop": [
      "contracts",
      "shared",
      "desktop"
    ],
    "media": [
      "contracts",
      "shared",
      "desktop",
      "media"
    ],
    "api": [
      "contracts",
      "shared",
      "api"
    ],
    "web": [
      "contracts",
      "shared",
      "web"
    ],
    "electron-main": [
      "contracts",
      "shared",
      "api",
      "electron-main"
    ],
    "electron-preload": [
      "contracts",
      "shared",
      "electron-preload"
    ],
    "electron-renderer": [
      "contracts",
      "shared",
      "electron-renderer"
    ],
    "companions": [
      "contracts",
      "shared",
      "companions"
    ]
  },
    "workspaceEntryPoints": {
      "@justybase/api-client": "packages/api-client/src/index.ts",
      "@justybase/metadata-core": "packages/metadata-core/src/index.ts",
      "@justybase/result-core": "packages/result-core/src/index.ts",
      "@justybase/sql-core": "packages/sql-core/src/index.ts",
      "@justybase/ui-core": "packages/ui-core/src/index.ts",
      "@justybase/ui-react": "packages/ui-react/src/index.ts"
  },
  "forbiddenImports": [
    {
      "layer": "desktop",
      "specifier": "^@justybase/netezza-driver(?:/|$)"
    },
    {
      "layer": "api",
      "specifier": "^@justybase/netezza-driver(?:/|$)"
    },
    {
      "layer": "companions",
      "specifier": "^@justybase/netezza-driver(?:/|$)"
    },
    {
      "source": "packages/database-runtime/src/**",
      "specifier": "^@justybase/netezza-driver(?:/|$)"
    },
    {
      "layer": "shared",
      "excludeSource": "packages/vscode-companion-adapter/src/**",
      "specifier": "^(?:vscode|electron)(?:/|$)"
    },
    {
      "source": "packages/designer-core/src/**",
      "specifier": "^(?:react|react-dom|node:|@justybase/(?:netezza-driver|spreadsheet-tasks)(?:/|$))"
    },
    {
      "source": "packages/ui-core/src/**",
      "specifier": "^(?:react|react-dom|node:|vscode|electron)(?:/|$)"
    },
    {
      "source": "packages/ui-react/src/**",
      "specifier": "^(?:node:|vscode|electron|@justybase/(?:database-runtime|duckdb-runtime|netezza-runtime|sqlite-runtime|web-api)(?:/|$))"
    },
    {
      "layer": "electron-renderer",
      "specifier": "^(?:node:|electron|vscode)(?:/|$)"
    }
  ],
  "exceptions": [],
  "cycleExceptions": []
}
