{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://justybase.github.io/justybase-vscode/schemas/quality-report.v1.json",
  "title": "JustyBase quality report",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "repository", "tests", "coverage", "lint", "modules", "dependencies", "documentation", "ci"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "repository": {
      "type": "object",
      "required": ["commit", "dirty"],
      "additionalProperties": false,
      "properties": {
        "commit": { "type": "string" },
        "base": { "type": ["string", "null"] },
        "dirty": { "type": "boolean" }
      }
    },
    "tests": {
      "type": "object",
      "required": ["suites", "tests", "skipped", "snapshots", "naturalExit"],
      "additionalProperties": false,
      "properties": {
        "suites": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "tests": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "skipped": { "type": "integer", "minimum": 0 },
        "snapshots": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "naturalExit": { "type": "boolean" }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["statements", "branches", "functions", "lines"],
      "additionalProperties": false,
      "properties": {
        "statements": { "type": "number", "minimum": 0, "maximum": 100 },
        "branches": { "type": "number", "minimum": 0, "maximum": 100 },
        "functions": { "type": "number", "minimum": 0, "maximum": 100 },
        "lines": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "lint": {
      "type": "object",
      "required": ["warnings", "errors", "byArea", "byRule"],
      "additionalProperties": false,
      "properties": {
        "warnings": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "byArea": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "byRule": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "modules": {
      "type": "object",
      "required": ["lineLimit", "overLimit"],
      "additionalProperties": false,
      "properties": {
        "lineLimit": { "type": "integer", "minimum": 1 },
        "overLimit": { "type": "array", "items": { "type": "object", "required": ["path", "lines"], "additionalProperties": false, "properties": { "path": { "type": "string" }, "lines": { "type": "integer", "minimum": 0 } } } }
      }
    },
    "dependencies": {
      "type": "object",
      "required": ["vulnerabilities", "auditStatus"],
      "additionalProperties": false,
      "properties": {
        "auditStatus": { "type": "string", "enum": ["pass", "fail", "missing"] },
        "vulnerabilities": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "documentation": {
      "type": "object",
      "required": ["checkStatus", "generatedPages", "roadmapLastAudited", "roadmapAgeDays"],
      "additionalProperties": false,
      "properties": {
        "checkStatus": { "type": "string", "enum": ["pass", "fail", "missing"] },
        "generatedPages": { "type": "integer", "minimum": 0 },
        "roadmapLastAudited": { "type": ["string", "null"] },
        "roadmapAgeDays": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "ci": {
      "type": "object",
      "required": ["node", "npmUserAgent", "lockfileSha256", "workflowSha256"],
      "additionalProperties": false,
      "properties": {
        "node": { "type": "string" },
        "npmUserAgent": { "type": "string" },
        "lockfileSha256": { "type": "string" },
        "workflowSha256": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  },
  "additionalProperties": false
}
