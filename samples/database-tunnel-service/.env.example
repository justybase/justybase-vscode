# Keep this service behind HTTPS/WSS in production.

# The client may select only these names. It never supplies host, port or
# database credentials. user_env and password_env name environment variables.
# tls: "off", "prefer" or "require". This example uses "off", which needs no
# certificate but does not encrypt traffic to the database, so use it only on a
# network you control. For encryption, use "require" (the certificate must verify),
# or add "tls_verify":false (not checked, which is unsafe). See the README.
JUSTYBASE_RELAY_TARGETS_JSON='{"netezza":{"host":"10.20.0.25","port":5480,"user_env":"NZ_SVC_USER","password_env":"NZ_SVC_PASSWORD","allowed_databases":["DEV"],"tls":"off"}}'
NZ_SVC_USER=replace-with-a-least-privilege-account
NZ_SVC_PASSWORD=replace-with-the-account-password

# Used by demo_service only. Your service has its own users and JWT settings.
DEMO_JWT_SECRET=replace-with-at-least-32-random-characters
DEMO_JWT_TTL_SECONDS=900
DEMO_USERNAME=analyst
DEMO_PASSWORD=replace-with-a-demo-password
