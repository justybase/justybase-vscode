# Keep this service behind HTTPS/WSS in production.
POSTGRES_TUNNEL_BIND_HOST=127.0.0.1
POSTGRES_TUNNEL_BIND_PORT=8000
POSTGRES_TUNNEL_TOKEN=replace-with-a-long-random-token
POSTGRES_TUNNEL_MAX_CONNECTIONS=32

# The client may select only these names. The client never supplies host/port.
POSTGRES_TUNNEL_TARGETS_JSON='{"reports":{"host":"127.0.0.1","port":5432}}'
