# Keep this service behind HTTPS/WSS in production.
DATABASE_TUNNEL_BIND_HOST=127.0.0.1
DATABASE_TUNNEL_BIND_PORT=8000
DATABASE_TUNNEL_TOKEN=replace-with-a-long-random-token
DATABASE_TUNNEL_MAX_CONNECTIONS=32

# The client may select only these names. The client never supplies host/port.
# Add PostgreSQL, Netezza, Oracle, or other approved TCP database targets.
DATABASE_TUNNEL_TARGETS_JSON='{"reports":{"host":"127.0.0.1","port":5432},"warehouse":{"host":"127.0.0.1","port":5480}}'
