        "--extensionDevelopmentPath=${workspaceFolder}/extensions/db2",
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/duckdb",
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/clickhouse",
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/mssql",
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/mysql",
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/oracle",
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/postgresql",
