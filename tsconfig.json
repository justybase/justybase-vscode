{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "bundler",
    "target": "es2020",
    "outDir": "out",
    "lib": ["es2020", "dom", "es2022.error"],
    "types": ["jest", "node"],
    "sourceMap": true,
    "rootDir": ".",
    "isolatedModules": true,
    "paths": {
      "@justybase/contracts": ["./packages/contracts/src"],
      "@justybase/contracts/*": ["./packages/contracts/src/*"],
      "@justybase/database-utils": ["./packages/database-utils/src"],
      "@justybase/database-utils/*": ["./packages/database-utils/src/*"],
      "@justybase/tabular-import-runtime": ["./packages/tabular-import-runtime/src"],
      "@justybase/tabular-import-runtime/*": ["./packages/tabular-import-runtime/src/*"],
      "@justybase/file-runtime": ["./packages/file-runtime/src"],
      "@justybase/file-runtime/*": ["./packages/file-runtime/src/*"],
      "@justybase/dialect-utils": ["./packages/dialect-utils/src"],
      "@justybase/dialect-utils/*": ["./packages/dialect-utils/src/*"],
      "@justybase/designer-core": ["./packages/designer-core/src"],
      "@justybase/designer-core/*": ["./packages/designer-core/src/*"],
      "@justybase/duckdb-runtime": ["./packages/duckdb-runtime/src"],
      "@justybase/duckdb-runtime/*": ["./packages/duckdb-runtime/src/*"],
      "@justybase/metadata-core": ["./packages/metadata-core/src"],
      "@justybase/metadata-core/*": ["./packages/metadata-core/src/*"],
      "@justybase/netezza-runtime": ["./packages/netezza-runtime/src"],
      "@justybase/netezza-runtime/*": ["./packages/netezza-runtime/src/*"],
      "@justybase/result-core": ["./packages/result-core/src"],
      "@justybase/result-core/*": ["./packages/result-core/src/*"],
      "@justybase/sql-core": ["./packages/sql-core/src/index.ts"],
      "@justybase/sql-core/*": ["./packages/sql-core/src/*"],
      "@justybase/sqlite-runtime": ["./packages/sqlite-runtime/src"],
      "@justybase/sqlite-runtime/*": ["./packages/sqlite-runtime/src/*"],
      "@justybase/vscode-companion-adapter": ["./packages/vscode-companion-adapter/src"],
      "@justybase/vscode-companion-adapter/*": ["./packages/vscode-companion-adapter/src/*"],
      "@core/*": ["./src/core/*"],
      "@metadata/*": ["./src/metadata/*"],
      "@types/*": ["./src/types/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "skipLibCheck": false
  },
  "include": [
    "src/**/*",
    "extensions/*/src/**/*.ts",
    "extensions/*/src/**/*.d.ts"
  ],
  "exclude": ["node_modules", ".vscode-test", "libs"]
}
