{
    "name": "justybaselite-mysql",
    "displayName": "JustyBase SQL Editor (MySQL)",
    "description": "Optional MySQL companion for JustyBase SQL Editor",
    "version": "3.17.9",
    "publisher": "krzysztof-d",
    "license": "Apache-2.0",
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.103.2",
        "node": ">=22.0.0"
    },
    "categories": [
        "Programming Languages",
        "Data Science",
        "Other"
    ],
    "homepage": "https://justybase.github.io/vscode/",
    "bugs": {
        "url": "https://github.com/justybase/justybase-vscode/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/justybase/justybase-vscode"
    },
    "keywords": [
        "SQL",
        "mysql",
        "mariadb",
        "database"
    ],
    "main": "./dist/extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "extensionDependencies": [
        "krzysztof-d.justybaselite-netezza"
    ],
    "contributes": {
        "submenus": [
            {
                "id": "justybase.mysql.tableStructures",
                "label": "MySQL: Table Structures",
                "icon": "$(symbol-structure)"
            }
        ],
        "commands": [
            {
                "command": "justybase.mysql.createIndexWizard",
                "title": "MySQL: Index Designer...",
                "icon": "$(symbol-key)"
            },
            {
                "command": "justybase.mysql.managePartitions",
                "title": "MySQL: Partition Manager...",
                "icon": "$(layout-panel)"
            }
        ],
        "menus": {
            "view/item/context": [
                {
                    "submenu": "justybase.mysql.tableStructures",
                    "when": "view == netezza.schema && (viewItem == netezza:TABLE || viewItem == favoritesObject:TABLE) && justybase.schemaDatabaseKind == mysql",
                    "group": "3_maintenance@1"
                }
            ],
            "justybase.mysql.tableStructures": [
                {
                    "command": "justybase.mysql.createIndexWizard",
                    "when": "view == netezza.schema && (viewItem == netezza:TABLE || viewItem == favoritesObject:TABLE) && justybase.schemaDatabaseKind == mysql",
                    "group": "1_index@1"
                },
                {
                    "command": "justybase.mysql.managePartitions",
                    "when": "view == netezza.schema && (viewItem == netezza:TABLE || viewItem == favoritesObject:TABLE) && justybase.schemaDatabaseKind == mysql",
                    "group": "2_partition@1"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build && node ../../scripts/generate-third-party-notices.js .",
        "build": "node esbuild.mysql.js",
        "build:minified": "node esbuild.mysql.js --minify",
        "build:dev": "node esbuild.mysql.js",
        "check-types": "node ../../node_modules/typescript/bin/tsc --project tsconfig.json --noEmit",
        "verify:runtime-deps": "node -e \"const fs = require('fs'); if (!fs.existsSync('node_modules/mysql2')) { console.error('Missing mysql2. Run npm install in extensions\\\\mysql before packaging.'); process.exit(1); }\"",
        "prepackage": "npm run verify:runtime-deps",
        "package": "node ../../scripts/package-optional-vsix.js package"
    },
    "dependencies": {
        "mysql2": "^3.11.5"
    },
    "preview": true
}
