{
  "name": "justybaselite-db2",
  "displayName": "JustyBase SQL Editor (Db2)",
  "description": "Optional Db2 LUW support for JustyBase: connect, metadata, DDL, explain/tuning, maintenance, and DB2 SQL quality rules (near-full runtime companion).",
  "version": "3.19.8",
  "publisher": "krzysztof-d",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.103.2",
    "node": ">=22.0.0"
  },
  "categories": [
    "Programming Languages",
    "Data Science",
    "Other"
  ],
  "homepage": "https://justybase.github.io/vscode/",
  "bugs": {
    "url": "https://github.com/justybase/justybase-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justybase/justybase-vscode"
  },
  "keywords": [
    "SQL",
    "db2",
    "ibm db2",
    "database"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "krzysztof-d.justybaselite-netezza"
  ],
  "scripts": {
    "vscode:prepublish": "npm run build && node ../../scripts/generate-third-party-notices.js .",
    "build": "node esbuild.db2.js",
    "build:minified": "node esbuild.db2.js --minify",
    "build:dev": "node esbuild.db2.js",
    "check-types": "node ../../node_modules/typescript/bin/tsc --project tsconfig.json --noEmit",
    "package": "node scripts/package-vsix.js package",
    "postpackage": "node scripts/verify-vsix.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "justybase.db2.createIndexWizard",
        "title": "Db2: Index Designer...",
        "icon": "$(symbol-key)"
      },
      {
        "command": "justybase.db2.managePartitions",
        "title": "Db2: Partition Manager...",
        "icon": "$(layout-panel)"
      },
      {
        "command": "justybase.db2.reorgIndexes",
        "title": "Db2: Reorganize Indexes",
        "icon": "$(tools)"
      },
      {
        "command": "justybase.db2.listIndexes",
        "title": "Db2: List Indexes",
        "icon": "$(list-tree)"
      },
      {
        "command": "justybase.db2.createIndex",
        "title": "Db2: Create Index...",
        "icon": "$(add)"
      },
      {
        "command": "justybase.db2.dropIndex",
        "title": "Db2: Drop Index...",
        "icon": "$(trash)"
      },
      {
        "command": "justybase.db2.listPartitions",
        "title": "Db2: List Partitions",
        "icon": "$(list-tree)"
      },
      {
        "command": "justybase.db2.addPartition",
        "title": "Db2: Add Partition...",
        "icon": "$(add)"
      },
      {
        "command": "justybase.db2.attachPartition",
        "title": "Db2: Attach Partition...",
        "icon": "$(link)"
      },
      {
        "command": "justybase.db2.detachPartition",
        "title": "Db2: Detach Partition...",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "justybase.db2.dropPartition",
        "title": "Db2: Drop Partition...",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "justybase.schema.structure": [
        {
          "command": "justybase.db2.createIndexWizard",
          "when": "view == netezza.schema && (viewItem == netezza:TABLE || viewItem == favoritesObject:TABLE) && justybase.schemaDatabaseKind == db2",
          "group": "3_index@20"
        },
        {
          "command": "justybase.db2.listIndexes",
          "when": "view == netezza.schema && (viewItem == netezza:TABLE || viewItem == favoritesObject:TABLE) && justybase.schemaDatabaseKind == db2",
          "group": "3_index@21"
        },
        {
          "command": "justybase.db2.managePartitions",
          "when": "view == netezza.schema && (viewItem == netezza:TABLE || viewItem == favoritesObject:TABLE) && justybase.schemaDatabaseKind == db2",
          "group": "5_partition@10"
        },
        {
          "command": "justybase.db2.listPartitions",
          "when": "view == netezza.schema && (viewItem == netezza:TABLE || viewItem == favoritesObject:TABLE) && justybase.schemaDatabaseKind == db2",
          "group": "5_partition@11"
        },
        {
          "command": "justybase.db2.dropIndex",
          "when": "view == netezza.schema && (viewItem == netezza:TABLE || viewItem == favoritesObject:TABLE) && justybase.schemaDatabaseKind == db2",
          "group": "3_index@22"
        },
        {
          "command": "justybase.db2.detachPartition",
          "when": "view == netezza.schema && (viewItem == netezza:TABLE || viewItem == favoritesObject:TABLE) && justybase.schemaDatabaseKind == db2",
          "group": "5_partition@12"
        },
        {
          "command": "justybase.db2.dropPartition",
          "when": "view == netezza.schema && (viewItem == netezza:TABLE || viewItem == favoritesObject:TABLE) && justybase.schemaDatabaseKind == db2",
          "group": "5_partition@13"
        }
      ],
      "justybase.schema.maintenance": [
        {
          "command": "justybase.db2.reorgIndexes",
          "when": "view == netezza.schema && (viewItem == netezza:TABLE || viewItem == favoritesObject:TABLE) && justybase.schemaDatabaseKind == db2",
          "group": "3_index@10"
        }
      ],
      "commandPalette": [
        {
          "command": "justybase.db2.listIndexes",
          "when": "false"
        },
        {
          "command": "justybase.db2.createIndex",
          "when": "false"
        },
        {
          "command": "justybase.db2.dropIndex",
          "when": "false"
        },
        {
          "command": "justybase.db2.listPartitions",
          "when": "false"
        },
        {
          "command": "justybase.db2.addPartition",
          "when": "false"
        },
        {
          "command": "justybase.db2.attachPartition",
          "when": "false"
        },
        {
          "command": "justybase.db2.detachPartition",
          "when": "false"
        },
        {
          "command": "justybase.db2.dropPartition",
          "when": "false"
        }
      ]
    }
  },
  "dependencies": {
    "@justybase/db2": "0.1.0-alpha.3"
  },
  "preview": true
}
