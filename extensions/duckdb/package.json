{
    "name": "justybaselite-duckdb",
    "displayName": "JustyBase SQL Editor (DuckDB + Files)",
    "description": "Optional DuckDB companion for JustyBase SQL Editor. Query Excel, CSV, Parquet and Avro files with SQL.",
    "version": "3.16.29",
    "publisher": "krzysztof-d",
    "license": "Apache-2.0",
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.103.2",
        "node": ">=22.0.0"
    },
    "categories": [
        "Programming Languages",
        "Data Science",
        "Other"
    ],
    "homepage": "https://github.com/justybase/justybase-vscode",
    "bugs": {
        "url": "https://github.com/justybase/justybase-vscode/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/justybase/justybase-vscode"
    },
    "keywords": [
        "SQL",
        "duckdb",
        "analytics",
        "database",
        "xlsx",
        "excel",
        "csv",
        "parquet",
        "avro",
        "files",
        "spreadsheet",
        "data files"
    ],
    "main": "./dist/extension.js",
    "activationEvents": [
        "onStartupFinished",
        "onCommand:justybase.duckdb.queryFile",
        "onCommand:justybase.duckdb.queryFiles",
        "onCommand:justybase.duckdb.addFiles",
        "onCommand:justybase.duckdb.openWorkspace",
        "onCommand:justybase.duckdb.saveFileEdits"
    ],
    "contributes": {
        "commands": [
            {
                "command": "justybase.duckdb.queryFile",
                "title": "Query File with SQL (DuckDB)",
                "icon": "$(file-binary)",
                "category": "JustyBase"
            },
            {
                "command": "justybase.duckdb.queryFiles",
                "title": "Query Multiple Files with SQL (DuckDB)",
                "icon": "$(files)",
                "category": "JustyBase"
            },
            {
                "command": "justybase.duckdb.openWorkspace",
                "title": "Open Saved File SQL Workspace",
                "icon": "$(folder-opened)",
                "category": "JustyBase"
            },
            {
                "command": "justybase.duckdb.addFiles",
                "title": "Add Files to Active File SQL Workspace (DuckDB)",
                "icon": "$(diff-added)",
                "category": "JustyBase"
            },
            {
                "command": "justybase.duckdb.saveFileEdits",
                "title": "Save File Edits (DuckDB)",
                "icon": "$(save)",
                "category": "JustyBase"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "justybase.duckdb.queryFile",
                    "when": "resourceExtname =~ /\\.(xlsx|csv|tsv|parquet|avro)$/",
                    "group": "JustyBase"
                },
                {
                    "command": "justybase.duckdb.queryFiles",
                    "when": "resourceExtname =~ /\\.(xlsx|csv|tsv|parquet|avro)$/",
                    "group": "JustyBase"
                },
                {
                    "command": "justybase.duckdb.addFiles",
                    "when": "resourceExtname =~ /\\.(xlsx|csv|tsv|parquet|avro)$/",
                    "group": "JustyBase"
                }
            ],
            "commandPalette": [
                {
                    "command": "justybase.duckdb.queryFile",
                    "when": "false"
                },
                {
                    "command": "justybase.duckdb.queryFiles"
                },
                {
                    "command": "justybase.duckdb.openWorkspace"
                },
                {
                    "command": "justybase.duckdb.addFiles"
                }
            ],
            "view/item/context": [
                {
                    "command": "justybase.duckdb.addFiles",
                    "when": "view == netezza.schema && viewItem == netezza:VIEW && justybase.schemaDatabaseKind == file",
                    "group": "JustyBase"
                }
            ]
        }
    },
    "extensionDependencies": [
        "krzysztof-d.justybaselite-netezza"
    ],
    "scripts": {
        "vscode:prepublish": "npm run build && node ../../scripts/generate-third-party-notices.js .",
        "build": "node esbuild.duckdb.js",
        "build:minified": "node esbuild.duckdb.js --minify",
        "build:dev": "node esbuild.duckdb.js",
        "check-types": "node ../../node_modules/typescript/bin/tsc --project tsconfig.json --noEmit",
        "verify:runtime-deps": "node -e \"const fs = require('fs'); if (!fs.existsSync('node_modules/@duckdb/node-api')) { console.error('Missing @duckdb/node-api. Run npm install in extensions\\\\duckdb before packaging.'); process.exit(1); }\"",
        "prepackage": "npm run verify:runtime-deps",
        "package": "node ../../scripts/package-optional-vsix.js package"
    },
    "dependencies": {
        "@duckdb/node-api": "^1.5.0-r.1"
    },
    "preview": true
}
