{
    "name": "justybaselite-access",
    "displayName": "JustyBase SQL Editor (Microsoft Access)",
    "description": "Optional Microsoft Access (.mdb/.accdb) companion for JustyBase SQL Editor. Pure Node.js/TypeScript file access with a DuckDB SQL mirror.",
    "version": "3.16.42",
    "publisher": "krzysztof-d",
    "license": "Apache-2.0",
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.103.2",
        "node": ">=22.0.0"
    },
    "categories": [
        "Programming Languages",
        "Data Science",
        "Other"
    ],
    "homepage": "https://github.com/justybase/justybase-vscode",
    "bugs": {
        "url": "https://github.com/justybase/justybase-vscode/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/justybase/justybase-vscode"
    },
    "keywords": [
        "SQL",
        "access",
        "mdb",
        "accdb",
        "microsoft access",
        "database",
        "data files"
    ],
    "main": "./dist/extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "extensionDependencies": [
        "krzysztof-d.justybaselite-netezza"
    ],
    "configuration": {
        "title": "Microsoft Access",
        "properties": {
            "justybase.access.readOnly": {
                "type": "boolean",
                "default": true,
                "scope": "machine",
                "description": "Open Microsoft Access databases without write intent."
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build && node ../../scripts/generate-third-party-notices.js .",
        "build": "node esbuild.access.js",
        "build:minified": "node esbuild.access.js --minify",
        "build:dev": "node esbuild.access.js",
        "check-types": "node ../../node_modules/typescript/bin/tsc --project tsconfig.json --noEmit",
        "verify:runtime-deps": "node -e \"const fs = require('fs'); for (const p of ['node_modules/@duckdb/node-api', 'node_modules/mdb-reader']) { if (!fs.existsSync(p)) { console.error('Missing Access runtime dependency: ' + p); process.exit(1); } }\"",
        "prepackage": "npm run verify:runtime-deps && node ../../scripts/generate-third-party-notices.js .",
        "package": "node ../../scripts/package-optional-vsix.js package"
    },
    "dependencies": {
        "@duckdb/node-api": "^1.5.0-r.1",
        "mdb-reader": "^3.2.0"
    },
    "preview": true
}
