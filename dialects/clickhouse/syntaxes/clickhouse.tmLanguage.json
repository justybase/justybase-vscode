{
  "scopeName": "clickhouse.injection",
  "name": "ClickHouse SQL",
  "injectionSelector": "L:source.sql - (string.quoted | comment.line | comment.block)",
  "patterns": [
    {
      "name": "comment.line.clickhouse.sql",
      "match": "#[^\\r\\n]*"
    },
    {
      "name": "keyword.other.clickhouse.sql",
      "match": "(?i)\\b(ARRAY\\s+JOIN|PREWHERE|QUALIFY|SAMPLE|FINAL|LIMIT\\s+BY|WITH\\s+FILL|WITH\\s+TIES|GLOBAL|ANY|ALL|ASOF|ANTI|SEMI|ENGINE|PARTITION\\s+BY|PRIMARY\\s+KEY|ORDER\\s+BY|SAMPLE\\s+BY|TTL|SETTINGS|OPTIMIZE|SYSTEM|KILL|QUERY|MATERIALIZED\\s+VIEW|POPULATE|PROJECTION|FORMAT|DICTIONARY)\\b"
    },
    {
      "name": "storage.type.clickhouse.sql",
      "match": "(?i)\\b(BOOL|BOOLEAN|DATE|DATE32|DATETIME|DATETIME64|DECIMAL(?:32|64|128|256)?|ENUM8|ENUM16|FIXEDSTRING|FLOAT32|FLOAT64|INT8|INT16|INT32|INT64|INT128|INT256|IPV4|IPV6|JSON|LOWCARDINALITY|MAP|NESTED|AGGREGATEFUNCTION|SIMPLEAGGREGATEFUNCTION|STRING|TUPLE|UINT8|UINT16|UINT32|UINT64|UINT128|UINT256|UUID|BFLOAT16)\\b"
    },
    {
      "name": "support.function.clickhouse.sql",
      "match": "(?i)\\b(ANY|ARGMAX|ARGMIN|ARRAYDISTINCT|ARRAYFILTER|ARRAYJOIN|ARRAYMAP|ARRAYREDUCE|ARRAYSORT|ASSUME_NOT_NULL|COALESCE|COUNT|COUNTDISTINCT|DICTGET|GROUPARRAY|GROUPBITAND|GROUPBITOR|GROUPBITXOR|GROUPUNIQARRAY|HAS|IF|IFNULL|INDEXOF|ISNULL|JSONEXTRACT(?:ARRAYRAW|BOOL|FLOAT|INT|KEY|RAW|STRING|UINT)?|LENGTH|LOWER|MAP|MEDIAN|MULTIIF|NOW|QUANTILE(?:EXACT|TDIGEST)?|REPLACEALL|TODAY|TODATE|TODATE32|TODATETIME|TODATETIME64|TOFIXEDSTRING|TOSTARTOF(?:DAY|HOUR|MONTH|WEEK|YEAR)|TOPK|TOSTRING|UNIQ(?:COMBINED|EXACT|HLL12)?)\\b(?=\\s*\\()"
    },
    {
      "name": "keyword.control.clickhouse.sql",
      "match": "(?i)\\b(EXPLAIN(?:\\s+PLAN)?|CREATE\\s+(?:TABLE|DATABASE|VIEW|MATERIALIZED\\s+VIEW)|DROP\\s+(?:TABLE|DATABASE|VIEW)|ALTER\\s+TABLE|INSERT\\s+INTO)\\b"
    }
  ],
  "repository": {}
}
