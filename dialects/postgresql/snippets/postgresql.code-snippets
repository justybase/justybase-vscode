{
  "SELECT with limit": {
    "prefix": ["pgselect", "pg-limit"],
    "body": [
      "SELECT ${1:*}",
      "FROM ${2:public}.${3:table_name}",
      "WHERE ${4:true}",
      "ORDER BY ${5:1}",
      "LIMIT ${6:100};"
    ],
    "description": "PostgreSQL SELECT with LIMIT"
  },
  "RETURNING": {
    "prefix": "pgreturning",
    "body": [
      "${1:INSERT INTO schema.table (column_name) VALUES (value)}",
      "RETURNING ${2:*};"
    ],
    "description": "PostgreSQL DML with RETURNING"
  },
  "ON CONFLICT": {
    "prefix": "pgonconflict",
    "body": [
      "INSERT INTO ${1:schema.table} (${2:key}, ${3:value})",
      "VALUES (${4:key}, ${5:value})",
      "ON CONFLICT (${2:key}) DO UPDATE SET ${3:value} = EXCLUDED.${3:value}",
      "RETURNING *;"
    ],
    "description": "PostgreSQL UPSERT with ON CONFLICT"
  },
  "CREATE TABLE": {
    "prefix": "pgcreatetable",
    "body": [
      "CREATE TABLE ${1:public}.${2:table_name} (",
      "  ${3:id} BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,",
      "  ${4:created_at} TIMESTAMPTZ NOT NULL DEFAULT now(),",
      "  ${5:name} TEXT",
      ");"
    ],
    "description": "PostgreSQL CREATE TABLE with identity and timestamps"
  },
  "CREATE INDEX": {
    "prefix": "pgcreateindex",
    "body": [
      "CREATE ${1|,UNIQUE|} INDEX ${2:index_name}",
      "ON ${3:public}.${4:table_name} USING ${5|btree,gin,gist,brin|} (${6:column_name});"
    ],
    "description": "PostgreSQL index definition"
  },
  "DO block": {
    "prefix": "pgdo",
    "body": [
      "DO $$",
      "DECLARE",
      "  ${1:variable_name} ${2:integer} := ${3:0};",
      "BEGIN",
      "  ${4:NULL;}",
      "END",
      "$$ LANGUAGE plpgsql;"
    ],
    "description": "Anonymous PostgreSQL PL/pgSQL block"
  },
  "CREATE FUNCTION": {
    "prefix": "pgfunction",
    "body": [
      "CREATE OR REPLACE FUNCTION ${1:public}.${2:function_name}(${3:p_value integer})",
      "RETURNS ${4:integer}",
      "LANGUAGE plpgsql",
      "AS $$",
      "BEGIN",
      "  RETURN ${5:p_value};",
      "END;",
      "$$;"
    ],
    "description": "PostgreSQL PL/pgSQL function skeleton"
  }
}
