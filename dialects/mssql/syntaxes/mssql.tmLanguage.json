{
  "scopeName": "mssql.injection",
  "name": "Microsoft SQL Server T-SQL",
  "injectionSelector": "L:source.sql - (string.quoted | comment.line | comment.block)",
  "patterns": [
    {
      "name": "keyword.other.mssql.sql",
      "match": "(?i)\\b(TOP|OUTPUT|CROSS\\s+APPLY|OUTER\\s+APPLY|OFFSET|FETCH\\s+NEXT|BEGIN\\s+TRY|BEGIN\\s+CATCH|END\\s+TRY|END\\s+CATCH|GO|WITH\\s+TIES|PERCENT)\\b"
    },
    {
      "name": "variable.other.mssql.sql",
      "match": "@@?[A-Za-z_][\\w$]*"
    },
    {
      "name": "entity.name.table.temporary.mssql.sql",
      "match": "##?[A-Za-z0-9_][\\w$]*"
    },
    {
      "name": "constant.other.bracketed-identifier.mssql.sql",
      "match": "\\[(?:[^\\]]|\\]\\])*\\]"
    }
  ],
  "repository": {}
}
