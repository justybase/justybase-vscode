{
  "scopeName": "db2.injection",
  "name": "Db2 SQL",
  "injectionSelector": "L:source.sql - (string.quoted | comment.line | comment.block)",
  "patterns": [
    {
      "name": "keyword.other.ddl.db2.sql",
      "match": "(?i)\\b(CREATE\\s+(?:UNIQUE\\s+)?INDEX|RENAME\\s+TABLE|LABEL\\s+ON|REORG\\s+(?:TABLE|INDEXES)|RUNSTATS|SET\\s+INTEGRITY|SET\\s+DATA\\s+TYPE|EXPORT\\s+TO|IMPORT\\s+FROM|REFRESH\\s+TABLE|ALTER\\s+SEQUENCE|COMMENT\\s+ON\\s+CONSTRAINT|EXECUTE\\s+IMMEDIATE|CREATE\\s+(?:ALIAS|SYNONYM|NICKNAME|TRIGGER)|DROP\\s+INDEX)\\b"
    },
    {
      "name": "keyword.other.dml.db2.sql",
      "match": "(?i)\\b(FETCH\\s+FIRST|OPTIMIZE\\s+FOR|FOR\\s+READ\\s+ONLY|FOR\\s+UPDATE|WITH\\s+(?:UR|CS|RS|RR)|FINAL\\s+TABLE|OLD\\s+TABLE|NEW\\s+TABLE|MODIFIED\\s+BY|INCLUDE\\s*\\(|ALLOW\\s+REVERSE\\s+SCANS|DISALLOW\\s+REVERSE\\s+SCANS|ON\\s+COMMIT\\s+(?:PRESERVE|DELETE)\\s+ROWS)\\b"
    },
    {
      "name": "keyword.other.db2.sql",
      "match": "(?i)\\b(DECLARE\\s+GLOBAL\\s+TEMPORARY|GENERATED\\s+(?:ALWAYS|BY\\s+DEFAULT|BY\\s+DEFAULT\\s+AS)|IDENTITY|ORGANIZE\\s+BY|DATA\\s+CAPTURE|DATA\\s+INITIALLY\\s+DEFERRED|REFRESH\\s+(?:DEFERRED|IMMEDIATE)|LANGUAGE\\s+SQL|CURRENT\\s+(?:SCHEMA|SERVER|DATE|TIME|TIMESTAMP|USER|SQLID|DEGREE|EXPLAIN\\s+MODE|EXPLAIN\\s+SNAPSHOT|SNAPSHOT|LOCK\\s+TIMEOUT|REFRESH\\s+AGE|QUERY\\s+OPTIMIZATION|QUERY\\s+ACCELERATION|MAINTAINED\\s+TABLE\\s+TYPES\\s+FOR\\s+OPTIMIZATION|DECFLOAT\\s+ROUNDING\\s+MODE|APPLICATION\\s+COMPATIBILITY|PACKAGE\\s+PATH|DEFAULT\\s+TRANSFORM\\s+GROUP|OPTIMIZATION\\s+PROFILE|FEDERATED\\s+ASYNCHRONY|IMPLICIT\\s+XMLPARSE\\s+OPTION|TEMPORAL\\s+SYSTEM_TIME|TEMPORAL\\s+BUSINESS_TIME|PATH|ISOLATION)|STARTING\\s+FROM|ENDING\\s+AT|MINVALUE|MAXVALUE|INCLUSIVE|EXCLUSIVE|COMPRESS\\s+(?:YES|NO)|NOT\\s+LOGGED\\s+INITIALLY|ACTIVATE\\s+NOT\\s+LOGGED|PCTFREE|MINPCTUSED|ORGANIZE\\s+BY\\s+(?:ROW|COLUMN))\\b"
    },
    {
      "name": "keyword.control.sqlpl.db2.sql",
      "match": "(?i)\\b(END\\s+(?:IF|WHILE|LOOP|FOR|REPEAT|CASE)|BEGIN\\s+ATOMIC|ELSIF|ELSEIF|WHILE|REPEAT|UNTIL|LOOP|SIGNAL|RESIGNAL|HANDLER|SQLEXCEPTION|SQLWARNING|NOT\\s+FOUND|SQLSTATE|SQLCODE|SQLERRM|MESSAGE_TEXT)\\b"
    },
    {
      "name": "storage.type.sqlpl.db2.sql",
      "match": "(?i)\\b(ALIAS\\s+FOR|CONSTANT|NOT\\s+NULL|VARRAY|ROWTYPE|RECORD|DECLARE\\s+(?:CONTINUE|EXIT)\\s+HANDLER)\\b"
    },
    {
      "name": "entity.name.function.db2.sql",
      "match": "(?i)\\b(ADMIN_CMD|SYSINSTALLOBJECTS|SYSPROC\\.\\w+|MON_GET_\\w+|SYSIBM\\.\\w+|SNAP_\\w+)\\b"
    }
  ],
  "repository": {}
}
