{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "jest", "@testing-library/jest-dom"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@justybase/contracts": ["../../packages/contracts/src"],
      "@justybase/designer-core": ["../../packages/designer-core/src"],
      "@justybase/dialect-utils": ["../../packages/dialect-utils/src"],
      "@justybase/sql-core": ["../../packages/sql-core/src"],
      "@justybase/result-core": ["../../packages/result-core/src"],
      "@justybase/ui-core": ["../../packages/ui-core/src"],
      "@justybase/ui-react": ["../../packages/ui-react/src"],
      "avalondock-web": ["../../vendor/dockyard/src/index.d.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
