# Required outside NODE_ENV=test
JUSTYBASE_MASTER_KEY=replace-with-a-long-random-secret

# Local administrator created on first start
JUSTYBASE_ADMIN_USER=admin
JUSTYBASE_ADMIN_PASSWORD=change-me

# Optional runtime settings
JUSTYBASE_HOST=127.0.0.1
JUSTYBASE_PORT=3000
# JUSTYBASE_DATA_DIR=.data/web-api
# JUSTYBASE_LOCAL_DB_ROOT=.data/web-api/local-databases
# JUSTYBASE_WEB_DIST_DIR=../web/dist
# Optional when @duckdb/node-api is installed outside the API workspace
# JUSTYBASE_DUCKDB_MODULE_PATH=../extensions/duckdb/node_modules/@duckdb/node-api
